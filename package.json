{
  "name": "pocketbase-server",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "pocketbase-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test tests/unit.test.mjs tests/protocol.test.mjs",
    "test:integration": "npm run build && node --test tests/integration.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "eventsource": "^5.1.2",
    "pocketbase": "^0.28.1",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
